#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>
#include <windows.h>

int main()
{
	SetConsoleCP(1251);
	SetConsoleOutputCP(1251);

	setlocale(LC_ALL, "RUS");
    double x, y;

    printf("Проверка принадлежности точки области\n");
    printf("Введите координаты точки (x y): ");
    if (scanf("%lf %lf", &x, &y) != 2) {
        printf("Ошибка: введены некорректные данные.\n");
        return 1;
    }
    if (x >= 0 && x <= 2 && y >= -1 && y <= 1) {
        printf("Точка (%.2lf, %.2lf) ПРИНАДЛЕЖИТ заданной области.\n", x, y);
    }
    else {
        printf("Точка (%.2lf, %.2lf) НЕ ПРИНАДЛЕЖИТ заданной области.\n", x, y);
    }

    return 0;
}
